### QuickBid - Admin control panel
### Usar con VS Code REST Client o IntelliJ HTTP Client.
### PELIGRO: muchos requests modifican datos. Revisar variables antes de ejecutar.

@baseUrl = http://localhost:8080
# Para Render:
# @baseUrl = https://REEMPLAZAR_BACKEND_RENDER_URL.onrender.com

# Cargar manualmente. No commitear claves reales.
@adminKey = REEMPLAZAR_ADMIN_KEY

@solicitudRegistroId = 9001
@cuentaUsuarioId = 3001
@cuentaBloqueadaId = 3003
@cuentaConsignadorId = 3004
@medioPagoId = 5001
@medioPagoConsignadorId = 5006
@subastaId = 6011
@catalogoId = 7011
@productoId = 8011
@itemCatalogoId = 9011
@compraId = 13001
@multaId = 14001
@consignacionId = 16111

### A. Health
# @name health
GET {{baseUrl}}/actuator/health

### B. Registro - listar solicitudes
# @name adminListarSolicitudes
GET {{baseUrl}}/api/admin/solicitudes-registro
X-QuickBid-Admin-Key: {{adminKey}}

### B. Registro - detalle solicitud
# @name adminDetalleSolicitud
GET {{baseUrl}}/api/admin/solicitudes-registro/{{solicitudRegistroId}}
X-QuickBid-Admin-Key: {{adminKey}}

### B. Registro - aprobar solicitud
# @name adminAprobarSolicitud
POST {{baseUrl}}/api/admin/solicitudes-registro/{{solicitudRegistroId}}/aprobar
X-QuickBid-Admin-Key: {{adminKey}}
Content-Type: application/json

{
  "documento": "DNI-DEMO-APROBADO",
  "categoriaInicial": "comun"
}

### B. Registro - rechazar solicitud
# @name adminRechazarSolicitud
POST {{baseUrl}}/api/admin/solicitudes-registro/{{solicitudRegistroId}}/rechazar
X-QuickBid-Admin-Key: {{adminKey}}
Content-Type: application/json

{
  "motivo": "Documentacion insuficiente para validar la cuenta."
}

### C. Usuarios - PELIGRO bloquear usuario
# @name adminBloquearUsuario
POST {{baseUrl}}/api/admin/usuarios/{{cuentaUsuarioId}}/bloquear
X-QuickBid-Admin-Key: {{adminKey}}

### C. Usuarios - desbloquear usuario
# @name adminDesbloquearUsuario
POST {{baseUrl}}/api/admin/usuarios/{{cuentaBloqueadaId}}/desbloquear
X-QuickBid-Admin-Key: {{adminKey}}

### C. Usuarios - ajustar puntos
# @name adminAjustarPuntos
PATCH {{baseUrl}}/api/admin/usuarios/{{cuentaUsuarioId}}/puntos
X-QuickBid-Admin-Key: {{adminKey}}
Content-Type: application/json

{
  "delta": 25
}

### C. Usuarios - cambiar categoria
# @name adminCambiarCategoria
PATCH {{baseUrl}}/api/admin/usuarios/{{cuentaUsuarioId}}/categoria
X-QuickBid-Admin-Key: {{adminKey}}
Content-Type: application/json

{
  "categoria": "plata"
}

### D. Medios de pago - listar por estado
# @name adminListarMediosVerificados
GET {{baseUrl}}/api/admin/medios-pago?estado=verificado
X-QuickBid-Admin-Key: {{adminKey}}

### D. Medios de pago - verificar con limite aprobado
# @name adminVerificarMedio
POST {{baseUrl}}/api/admin/medios-pago/{{medioPagoId}}/verificar
X-QuickBid-Admin-Key: {{adminKey}}
Content-Type: application/json

{
  "limiteAprobado": 500000
}

### D. Medios de pago - rechazar medio
# @name adminRechazarMedio
POST {{baseUrl}}/api/admin/medios-pago/{{medioPagoId}}/rechazar
X-QuickBid-Admin-Key: {{adminKey}}
Content-Type: application/json

{
  "motivo": "Documento del medio de pago no legible."
}

### D. Medios de pago - vencer expirados
# @name adminVencerMediosExpirados
POST {{baseUrl}}/api/admin/medios-pago/vencer-expirados
X-QuickBid-Admin-Key: {{adminKey}}

### E. Jobs - procesar vencimientos generales
# @name adminProcesarVencimientos
POST {{baseUrl}}/api/admin/vencimientos/procesar
X-QuickBid-Admin-Key: {{adminKey}}

### E. Jobs - vencer multas expiradas
# @name adminVencerMultasExpiradas
POST {{baseUrl}}/api/admin/multas/vencer-expiradas
X-QuickBid-Admin-Key: {{adminKey}}

### E. Jobs - abandonar compras vencidas
# @name adminAbandonarComprasVencidas
POST {{baseUrl}}/api/admin/compras/abandonar-vencidas
X-QuickBid-Admin-Key: {{adminKey}}

### E. Jobs - vencer devoluciones de consignacion
# @name adminVencerDevolucionesConsignacion
POST {{baseUrl}}/api/admin/consignaciones/devoluciones/vencer
X-QuickBid-Admin-Key: {{adminKey}}

### E. Jobs - limpiar notificaciones antiguas
# @name adminLimpiarNotificaciones
POST {{baseUrl}}/api/admin/notificaciones/limpiar
X-QuickBid-Admin-Key: {{adminKey}}

### F. Subastas - crear subasta
# @name adminCrearSubasta
POST {{baseUrl}}/api/admin/subastas
X-QuickBid-Admin-Key: {{adminKey}}
Content-Type: application/json

{
  "fecha": "2026-12-20",
  "hora": "20:00:00",
  "titulo": "Subasta admin de prueba",
  "descripcion": "Subasta creada desde el panel HTTP.",
  "ubicacion": "Salon QuickBid",
  "categoria": "plata",
  "moneda": "ARS",
  "segmento": "demo",
  "permiteInscripcionOnline": true
}

### F. Subastas - actualizar subasta
# @name adminActualizarSubasta
PATCH {{baseUrl}}/api/admin/subastas/{{subastaId}}
X-QuickBid-Admin-Key: {{adminKey}}
Content-Type: application/json

{
  "fecha": "2026-12-21",
  "hora": "20:30:00",
  "titulo": "Subasta admin actualizada",
  "descripcion": "Subasta actualizada desde el panel HTTP.",
  "ubicacion": "Salon QuickBid",
  "categoria": "plata",
  "segmento": "demo",
  "permiteInscripcionOnline": true
}

### F. Subastas - abrir subasta
# @name adminAbrirSubasta
POST {{baseUrl}}/api/admin/subastas/{{subastaId}}/abrir
X-QuickBid-Admin-Key: {{adminKey}}

### F. Subastas - PELIGRO cerrar subasta
# @name adminCerrarSubasta
POST {{baseUrl}}/api/admin/subastas/{{subastaId}}/cerrar
X-QuickBid-Admin-Key: {{adminKey}}

### F. Subastas - setear item activo
# @name adminSetearItemActivo
POST {{baseUrl}}/api/admin/subastas/{{subastaId}}/item-activo
X-QuickBid-Admin-Key: {{adminKey}}
Content-Type: application/json

{
  "itemCatalogoId": {{itemCatalogoId}}
}

### F. Subastas - cerrar lote AUTO
# @name adminCerrarLoteAuto
POST {{baseUrl}}/api/admin/subastas/{{subastaId}}/cerrar-lote?resultado=AUTO
X-QuickBid-Admin-Key: {{adminKey}}

### F. Subastas - cerrar lote SUCCESS
# @name adminCerrarLoteSuccess
POST {{baseUrl}}/api/admin/subastas/{{subastaId}}/cerrar-lote?resultado=SUCCESS
X-QuickBid-Admin-Key: {{adminKey}}

### F. Subastas - PELIGRO cerrar lote FAILURE
# @name adminCerrarLoteFailure
POST {{baseUrl}}/api/admin/subastas/{{subastaId}}/cerrar-lote?resultado=FAILURE
X-QuickBid-Admin-Key: {{adminKey}}

### F. Subastas - procesar timers
# @name adminProcesarTimersSubasta
POST {{baseUrl}}/api/admin/subastas/timers/procesar
X-QuickBid-Admin-Key: {{adminKey}}

### F. Subastas - agregar item al catalogo
# @name adminAgregarItemCatalogo
POST {{baseUrl}}/api/admin/subastas/{{subastaId}}/catalogo/items
X-QuickBid-Admin-Key: {{adminKey}}
Content-Type: application/json

{
  "catalogoId": {{catalogoId}},
  "productoId": {{productoId}},
  "precioBase": 50000,
  "comision": 5000
}

### G. Compras - simular pago exitoso
# @name adminSimularPagoExitoso
POST {{baseUrl}}/api/admin/compras/{{compraId}}/simular-pago-exitoso
X-QuickBid-Admin-Key: {{adminKey}}
Content-Type: application/json

{
  "cuentaId": {{cuentaUsuarioId}},
  "medioPagoId": {{medioPagoId}},
  "tipo": "extras"
}

### G. Compras - simular falla de pago
# @name adminSimularFallaPago
POST {{baseUrl}}/api/admin/compras/{{compraId}}/simular-falla-pago
X-QuickBid-Admin-Key: {{adminKey}}
Content-Type: application/json

{
  "cuentaId": {{cuentaUsuarioId}},
  "medioPagoId": {{medioPagoId}},
  "tipo": "extras"
}

### G. Compras - PELIGRO abandonar compra
# @name adminAbandonarCompra
POST {{baseUrl}}/api/admin/compras/{{compraId}}/abandonar?retiro=false
X-QuickBid-Admin-Key: {{adminKey}}

### G. Compras - PELIGRO abandonar compra por retiro
# @name adminAbandonarCompraRetiro
POST {{baseUrl}}/api/admin/compras/{{compraId}}/abandonar?retiro=true
X-QuickBid-Admin-Key: {{adminKey}}

### H. Multas - PELIGRO vencer multa
# @name adminVencerMulta
POST {{baseUrl}}/api/admin/multas/{{multaId}}/vencer
X-QuickBid-Admin-Key: {{adminKey}}

### H. Multas - marcar multa pagada
# @name adminMarcarMultaPagada
POST {{baseUrl}}/api/admin/multas/{{multaId}}/marcar-pagada
X-QuickBid-Admin-Key: {{adminKey}}

### I. Consignaciones - listar admin
# @name adminListarConsignaciones
GET {{baseUrl}}/api/admin/consignaciones
X-QuickBid-Admin-Key: {{adminKey}}

### I. Consignaciones - pedir documentacion
# @name adminPedirDocumentacionConsignacion
POST {{baseUrl}}/api/admin/consignaciones/{{consignacionId}}/pedir-documentacion
X-QuickBid-Admin-Key: {{adminKey}}

### I. Consignaciones - rechazar consignacion
# @name adminRechazarConsignacion
POST {{baseUrl}}/api/admin/consignaciones/{{consignacionId}}/rechazar
X-QuickBid-Admin-Key: {{adminKey}}
Content-Type: application/json

{
  "motivo": "No cumple los requisitos de publicacion."
}

### I. Consignaciones - aprobar revision digital
# @name adminAprobarRevisionDigital
POST {{baseUrl}}/api/admin/consignaciones/{{consignacionId}}/aprobar-revision-digital
X-QuickBid-Admin-Key: {{adminKey}}

### I. Consignaciones - asignar categoria
# @name adminAsignarCategoriaConsignacion
PATCH {{baseUrl}}/api/admin/consignaciones/{{consignacionId}}/categoria
X-QuickBid-Admin-Key: {{adminKey}}
Content-Type: application/json

{
  "categoria": "plata"
}

### I. Consignaciones - revisar documentacion aprobada
# @name adminRevisarDocumentacionAprobada
POST {{baseUrl}}/api/admin/consignaciones/{{consignacionId}}/revisar-documentacion
X-QuickBid-Admin-Key: {{adminKey}}
Content-Type: application/json

{
  "aprobada": true,
  "motivo": "Documentacion validada."
}

### I. Consignaciones - revisar documentacion rechazada
# @name adminRevisarDocumentacionRechazada
POST {{baseUrl}}/api/admin/consignaciones/{{consignacionId}}/revisar-documentacion
X-QuickBid-Admin-Key: {{adminKey}}
Content-Type: application/json

{
  "aprobada": false,
  "motivo": "Falta documentacion respaldatoria."
}

### I. Consignaciones - marcar recibida fisicamente
# @name adminMarcarRecibidaFisicamente
POST {{baseUrl}}/api/admin/consignaciones/{{consignacionId}}/marcar-recibida-fisicamente
X-QuickBid-Admin-Key: {{adminKey}}

### I. Consignaciones - aprobar revision fisica
# @name adminAprobarRevisionFisica
POST {{baseUrl}}/api/admin/consignaciones/{{consignacionId}}/aprobar-revision-fisica
X-QuickBid-Admin-Key: {{adminKey}}

### I. Consignaciones - rechazar revision fisica
# @name adminRechazarRevisionFisica
POST {{baseUrl}}/api/admin/consignaciones/{{consignacionId}}/rechazar-revision-fisica
X-QuickBid-Admin-Key: {{adminKey}}
Content-Type: application/json

{
  "motivo": "El estado fisico no coincide con lo declarado."
}

### I. Consignaciones - marcar devolucion incompleta
# @name adminMarcarDevolucionIncompleta
POST {{baseUrl}}/api/admin/consignaciones/{{consignacionId}}/marcar-devolucion-incompleta
X-QuickBid-Admin-Key: {{adminKey}}

### I. Consignaciones - verificar duenio
# @name adminVerificarDuenio
POST {{baseUrl}}/api/admin/consignadores/{{cuentaConsignadorId}}/verificar-duenio
X-QuickBid-Admin-Key: {{adminKey}}
Content-Type: application/json

{
  "financiera": false,
  "judicial": false,
  "riesgo": 10
}

### I. Consignaciones - proponer acuerdo
# @name adminProponerAcuerdo
POST {{baseUrl}}/api/admin/consignaciones/{{consignacionId}}/proponer-acuerdo
X-QuickBid-Admin-Key: {{adminKey}}
Content-Type: application/json

{
  "valorBase": 50000,
  "moneda": "ARS",
  "comisionCompradorPct": 10,
  "comisionVendedorPct": 10,
  "condiciones": "Acuerdo demo generado desde panel HTTP."
}

### I. Consignaciones - asignar a subasta
# @name adminAsignarSubasta
POST {{baseUrl}}/api/admin/consignaciones/{{consignacionId}}/asignar-subasta
X-QuickBid-Admin-Key: {{adminKey}}
Content-Type: application/json

{
  "subastaId": {{subastaId}},
  "catalogoId": {{catalogoId}},
  "polizaCombinada": "POL-DEMO-HTTP"
}

### I. Consignaciones - liquidar
# @name adminLiquidarConsignacion
POST {{baseUrl}}/api/admin/consignaciones/{{consignacionId}}/liquidar
X-QuickBid-Admin-Key: {{adminKey}}
Content-Type: application/json

{
  "medioPagoId": {{medioPagoConsignadorId}}
}

